---
import Site from '../layouts/Site.astro';
---
<Site title="Search | Highlander Robotics" description="Search Highlander Robotics robots, membership, sponsorship, outreach, and team information." search>
  <section class="mx-auto max-w-4xl px-6 py-20">
    <h1 class="mb-4 text-4xl font-bold text-purple-900">Search Highlander Robotics</h1>
    <p class="mb-8 text-lg">Find team information, robots, outreach, and ways to get involved.</p>
    <div id="search"></div>
    <p id="search-status" role="status" class="mt-6">Loading search…</p>
  </section>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    if (window.PagefindUI) {
      new PagefindUI({ element: '#search', showSubResults: true });
      document.querySelector('#search-status').textContent = '';
    } else {
      document.querySelector('#search-status').textContent = 'Search is generated by npm run build. Use npm run preview to search the built site.';
    }
  </script>
</Site>
