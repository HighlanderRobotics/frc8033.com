---
import { load } from 'cheerio';
import chrome from '../data/chrome.json';
// Keep the existing CMS-managed navigation source, rendered with native controls.
const $ = load(chrome.header);
const logo = $('.navbar-brand img').first();
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const groups = $('.w-dropdown').toArray().flatMap(el => {
  const label = $(el).find('.w-dropdown-toggle a').first();
  if (!label.text().trim()) return [];
  const links = $(el).find('.w-dropdown-list a').toArray().map(a => ({ label: $(a).text().trim(), href: $(a).attr('href')!, external: $(a).attr('target') === '_blank' }));
  const href = label.attr('href')!;
  links.unshift({label: label.text().trim() === 'Robots' ? 'All Robots' : label.text().trim() === 'About' ? 'About the Team' : 'Outreach Overview', href, external: false});
  return [{ label: label.text().trim(), links }];
});
const actions = $('.list-item-2 a').toArray().map(a => ({ label: $(a).text().trim(), href: $(a).attr('href')!, external: $(a).attr('target') === '_blank' }));
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="site-logo" aria-label="Highlander Robotics home" aria-current={path === '/' ? 'page' : undefined}>
      <img src={logo.attr('src')} srcset={logo.attr('srcset')} sizes="170px" width="170" height="56" alt="8033 Highlander Robotics" fetchpriority="high" />
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      <span>Menu</span>
    </button>
    <nav class="site-navigation" id="primary-navigation" aria-label="Main navigation">
      <ul class="nav-groups">
        {groups.map(group => <li>
          <details class="nav-dropdown">
            <summary class:list={["nav-summary", { 'is-current': group.links.some(link => link.href === path) }]}>
              {group.label}<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 7.5 5 5 5-5" /></svg>
            </summary>
            <ul class="nav-dropdown-panel">
              {group.links.map(link => <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} aria-current={link.href === path ? 'page' : undefined}>{link.label}</a></li>)}
            </ul>
          </details>
        </li>)}
      </ul>
      <div class="nav-actions">
        {actions.filter(a => a.label !== 'Donate').map(link => <a class="nav-action" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} aria-current={link.href === path ? 'page' : undefined}>{link.label}</a>)}
        <a class="nav-action nav-search" href="/search" aria-current={path === '/search' ? 'page' : undefined}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>Search</a>
        {actions.filter(a => a.label === 'Donate').map(link => <a class="site-button" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
      </div>
    </nav>
  </div>
</header>
